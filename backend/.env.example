DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shramasa?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=86400
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_SEED_PASSWORD=Admin@12345
# Google Identity Services — same Web client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# Live keys start with rzp_live_ — test keys are rejected in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional — recommended for payment.captured / order.paid webhooks
# Webhook URL: https://<api-host>/orders/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Optional — enable password-reset emails (omit in local dev to log the link)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
